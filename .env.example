NODE_ENV=development
TRANSFER_PAYMENTS_ENABLED=false
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PREFIX=montepica/receipts/
S3_FORCE_PATH_STYLE=false
PORT=3000

# PostgreSQL instalado localmente
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=monte_pica_app
DB_PASSWORD=cambia_esta_clave_local
DB_NAME=monte_pica
DB_LOGGING=false
# En producción, omitir DB_TLS usa true. Configurar CA PEM si no es pública.
DB_TLS_CA=
TRUST_PROXY=
JWT_ACCESS_SECRET=reemplaza_con_una_clave_aleatoria_de_32_bytes

# Orígenes web separados por coma; Expo nativo no depende de CORS.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Omitir PASSWORD_RECOVERY_ENABLED usa false en local y true en producción.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
